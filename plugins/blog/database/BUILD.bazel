# Blog Database Module
package(default_visibility = ["//visibility:public"])

# Blog Database Library
cc_library(
    name = "blog_database",
    srcs = [
        "database.cppm",
        "post_repository.cppm",
        "tag_repository.cppm",
        "author_repository.cppm",
        "migration_manager.cppm",
    ],
    hdrs = [],
    copts = [
        "-std=c++20",
        "-fmodules-ts",
        "-I../../include",
    ],
    deps = [
        "@nlohmann_json//:nlohmann_json",
        "@boost//:system",
        "@boost//:thread",
        "@boost//:asio",
        "//include/connector:connector_lib",
        "//include/core/contract:contract_lib",
        "//include/core/config:config_lib",
        "//include/shared:shared_lib",
        "//include/interfaces:interfaces_lib",
        "//plugins/blog/api:blog_api",
    ],
)

# Blog Database Tests
cc_test(
    name = "blog_database_test",
    srcs = [
        "database_test.cppm",
    ],
    deps = [
        ":blog_database",
        "@gtest//:gtest",
        "@gtest//:gtest_main",
    ],
    copts = [
        "-std=c++20",
        "-fmodules-ts",
    ],
)

exports_files([
    "database.cppm",
    "post_repository.cppm",
    "tag_repository.cppm",
    "author_repository.cppm",
    "migration_manager.cppm",
])