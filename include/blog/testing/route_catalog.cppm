class RouteInfo
{
public:
    [[nodiscard]] std::string_view method() const noexcept { return m_method; }
    [[nodiscard]] std::string_view path() const noexcept { return m_path; }
    [[nodiscard]] std::string_view resource() const noexcept { return m_resource; }
    [[nodiscard]] std::string_view action() const noexcept { return m_action; }
    [[nodiscard]] bool admin() const noexcept { return m_admin; }

    std::string_view m_method;
    std::string_view m_path;
    std::string_view m_resource;
    std::string_view m_action;
    bool m_admin;
};

