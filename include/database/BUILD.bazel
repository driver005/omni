package(default_visibility = ["//visibility:public"])

load("//toolchain:cc_rules.bzl", "cc_library")

cc_library(
    name = "database_lib",
    tags = ["manual"],
    srcs = glob(["*.cppm"]),
    includes = [".", "database"],
    copts = [
        "-std=c++20",
        "-fmodules-ts",
        "-Wall",
        "-Wextra",
        "-Wpedantic",
    ],
    deps = [
        "//include/reflection:reflection_lib",
        "@nlohmann_json//:json",
        "@fmt//:fmt",
        "@spdlog//:spdlog",
    ],
)