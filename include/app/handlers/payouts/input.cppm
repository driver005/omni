export module app_handlers_payouts:input;

import std;
import interfaces;
import core_error;
import core_serde;
import app_context;
import app_auth;
import app_http;
import app_model;

export namespace app::handlers::payouts {

// ───────────────────────── Plain request data ─────────────────────────

/**
 * @brief `common_utils::types::TimeRange` (`common_utils/src/types.rs:809-822`).
 * `start_time` mandatory with alias `startTime`; `end_time` optional with alias `endTime`.
 */
struct TimeRange
{
    std::string start_time{};
    std::optional<std::string> end_time{};
    bool present{};
};

/** @brief Filter fields of upstream `PayoutListFilterConstraints`
 * (`api_models/payouts.rs:1325-1368`). */
struct ListFilters
{
    std::string payout_id{};
    std::string merchant_order_reference_id{};
    std::string customer_id{};
    std::vector<std::string> connector{};
    std::vector<std::string> currency{};
    std::vector<std::string> status{};
    std::vector<std::string> payout_method{};
    std::string entity_type{};
    std::size_t offset{};
    std::size_t limit{};
};

/** @brief Query fallbacks for the typed filter DTO (`api_models/payouts.rs:1325-1368`). */
struct PayoutListQuery
{
    std::string payout_id{};
    std::string customer_id{};
    std::optional<std::string> offset{};
    std::optional<std::string> limit{};
};

