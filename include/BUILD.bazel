package(default_visibility = ["//visibility:public"])

load("//toolchain:cc_rules.bzl", "cc_library")

cc_library(
    name = "database_lib",
    tags = ["manual"],
    srcs = glob(["database/*.cppm"]),
    hdrs = glob(["database/*.cppm"]),
    includes = [".", "database"],
    copts = [
        "-std=c++20",
        "-fmodules-ts",
        "-Wall",
        "-Wextra",
        "-Wpedantic",
    ],
    deps = [
        "//include/reflection:reflection_lib",
        "@nlohmann_json//:json",
        "@fmt//:fmt",
        "@spdlog//:spdlog",
    ],
)

cc_library(
    name = "reflection_lib",
    tags = ["manual"],
    srcs = glob(["reflection/*.cppm"]),
    hdrs = glob(["reflection/*.cppm"]),
    includes = [".", "reflection"],
    copts = [
        "-std=c++20",
        "-fmodules-ts",
        "-Wall",
        "-Wextra",
        "-Wpedantic",
    ],
    deps = [
        "//include/database:database_lib",
    ],
)

cc_library(
    name = "router_lib",
    tags = ["manual"],
    srcs = glob(["router/*.cppm"]),
    includes = [".", "router"],
    copts = [
        "-std=c++20",
        "-fmodules-ts",
        "-Wall",
        "-Wextra",
        "-Wpedantic",
    ],
    deps = [
        "//include/http:http_lib",
    ],
)

cc_library(
    name = "http_lib",
    tags = ["manual"],
    srcs = glob(["http/*.cppm"]),
    includes = [".", "http"],
    copts = [
        "-std=c++20",
        "-fmodules-ts",
        "-Wall",
        "-Wextra",
        "-Wpedantic",
    ],
    deps = [
        "@nlohmann_json//:json",
    ],
)

cc_library(
    name = "all_lib",
    tags = ["manual"],
    srcs = [],
    deps = [
        ":database_lib",
        ":reflection_lib",
        ":router_lib",
        ":http_lib",
    ],
)