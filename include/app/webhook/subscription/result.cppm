export module app_webhook:subscription_result;

import std;
import core_serde;

export namespace app::handlers::subscription {

// Subscription success bodies are optional-heavy dynamic documents. Each result
// carries a typed serde::Value tree (Object/Array/null built from typed fields);
// handler.cppm writes it with serde::Ser::serialize. No hand-built JSON text.

class CreateSubscriptionResult
{
public:
    CreateSubscriptionResult() = default;

    explicit CreateSubscriptionResult(serde::Value document) noexcept :
        m_document{std::move(document)}
    {
    }

    [[nodiscard]] const serde::Value& get_document() const noexcept
    {
        return m_document;
    }

    void set_document(serde::Value value)
    {
        m_document = std::move(value);
    }

private:
    serde::Value m_document{};
};

