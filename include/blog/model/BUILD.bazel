load("//bazel:build_defs.bzl", "congelado_module_library", "congelado_cc_test")

congelado_module_library(
    name = "blog_model",
    primary_interface = "base.cppm",
    partitions = [
        "post.cppm",
        "page.cppm",
        "tag.cppm",
        "author.cppm",
        "user.cppm",
        "member.cppm",
        "setting.cppm",
        "newsletter.cppm",
        "tier.cppm",
        "comment.cppm",
        "invite.cppm",
        "offer.cppm",
        "webhook.cppm",
        "label.cppm",
        "snippet.cppm",
        "recommendation.cppm",
        "wire_fixtures.cppm",
    ],
    deps = ["//include/core/database:core_database"],
    hdrs = ["entity_macros.h"],
    visibility = ["//visibility:public"],
)

congelado_cc_test(
    name = "serde_bridge_test",
    srcs = ["serde_bridge_test.cc"],
    linkopts = ["-lcrypto", "-lssl"],
    deps = [
        ":blog_model",
        "//include/core/database:core_database",
        "//plugins/memory:memory_backends",
    ],
)
