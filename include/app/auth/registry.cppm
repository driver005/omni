/** @brief Routes intentionally unauthenticated upstream, with report evidence. */
inline constexpr std::array<std::string_view, 31> kNoAuthOperations{{
    "authorize_token",
    "create_email_client",
    "deep_health_check",
    "dummy_connector_authorize_payment",
    "dummy_connector_complete_payment",
    "dummy_connector_payment",
    "dummy_connector_payment_data",
    "dummy_connector_refund",
    "dummy_connector_refund_data",
    "fetch_feature_matrix",
    "forgot_password",
    "get_sso_auth_url",
    "get_store_interface",
    "health",
    "jwks_endpoint",
    "list_user_authentication_methods",
    "new",
    "oidc_authorize",
    "oidc_discovery",
    "payment_callback_config",
    "receive_network_token_requestor_incoming_webhook",
    "signout_hypersense_token",
    "sso_sign",
    "user_connect_account",
    "user_from_email",
    "user_signin",
    "user_signup",
    "validate_token",
    "verify_email_request",
    "verify_hypersense_token",
    "with_storage",
}};

/** @brief Instance resolver from an operation name to its declarative auth rule. */
class RouteAuthRegistry
{
public:
    /** @brief Missing non-whitelisted operations fail closed with a FORBIDDEN rule. */
    [[nodiscard]] RouteAuthRule rule_for(std::string_view operation_name) const
    {
        for (const auto& entry : kRouteAuthTable) {
            if (entry.operation == operation_name) {
                return RouteAuthRule{
                    entry.scheme,
                    entry.permission,
                    entry.allow_connected,
                    entry.allow_platform,
                    entry.id_source.empty() ? std::optional<std::string>{} :
                        std::optional<std::string>{std::string{entry.id_source}},
                };
            }
        }
        if (is_no_auth(operation_name)) {
            return RouteAuthRule{AuthScheme::NO_AUTH, AppPermission::ADMIN};
        }
        return RouteAuthRule{AuthScheme::FORBIDDEN, AppPermission::ADMIN};
    }

    [[nodiscard]] bool is_no_auth(std::string_view operation_name) const noexcept
    {
        for (const auto name : kNoAuthOperations) {
            if (name == operation_name) {
                return true;
            }
        }
        return false;
    }

    [[nodiscard]] std::size_t size() const noexcept
    {
        return kRouteAuthTable.size();
    }

    [[nodiscard]] std::span<const RouteAuthEntry> entries() const noexcept
    {
        return kRouteAuthTable;
    }
};

} // namespace app::auth

#ifdef CONGELADO_TEST
namespace app::auth::tests {
using namespace boost::ut;

suite<"app_auth_registry"> registry_suite = []
{
    "resolves a known operation to its declared rule"_test = []
    {
        const RouteAuthRegistry registry;
        expect(registry.size() > 0u);
        const auto rule = registry.rule_for("payments_create_intent");
        expect(rule.scheme() != AuthScheme::FORBIDDEN);
        expect(rule.permission() == AppPermission::PAYMENT_WRITE);
    };

    "unknown operation fails closed with FORBIDDEN"_test = []
    {
        const RouteAuthRegistry registry;
        const auto rule = registry.rule_for("__not_a_route__");
        expect(rule.scheme() == AuthScheme::FORBIDDEN);
    };

    "whitelisted operations resolve to NO_AUTH"_test = []
    {
        const RouteAuthRegistry registry;
        for (const auto op : kNoAuthOperations) {
            expect(registry.rule_for(op).scheme() == AuthScheme::NO_AUTH);
        }
    };
};

} // namespace app::auth::tests
#endif
