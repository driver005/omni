load("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

workspace(name = "medusa_cpp")

# nlohmann_json
http_archive(
    name = "nlohmann_json",
    urls = ["https://github.com/nlohmann/json/archive/refs/tags/v3.11.2.tar.gz"],
    strip_prefix = "json-3.11.2",
    build_file_content = """
package(default_visibility = ["//visibility:public"])

cc_library(
    name = "nlohmann_json",
    srcs = ["include/nlohmann/json.hpp"],
    hdrs = ["include/nlohmann/json.hpp"],
    includes = ["include"],
    copts = ["-std=c++20"],
)
"""
)

# fmt
http_archive(
    name = "fmt",
    urls = ["https://github.com/fmtlib/fmt/archive/refs/tags/10.2.1.tar.gz"],
    strip_prefix = "fmt-10.2.1",
    build_file_content = """
package(default_visibility = ["//visibility:public"])

cc_library(
    name = "fmt",
    srcs = glob(["src/*.cc"]),
    hdrs = glob(["include/fmt/*.h"]),
    includes = ["include"],
    copts = ["-std=c++20"],
)
"""
)

# spdlog
http_archive(
    name = "spdlog",
    urls = ["https://github.com/gabime/spdlog/archive/refs/tags/v1.13.0.tar.gz"],
    strip_prefix = "spdlog-1.13.0",
    build_file_content = """
package(default_visibility = ["//visibility:public"])

cc_library(
    name = "spdlog",
    srcs = glob(["src/*.cpp"]),
    hdrs = glob(["include/spdlog/*.h"]),
    includes = ["include"],
    copts = ["-std=c++20", "-DSPDLOG_COMPILED_LIB"],
)
"""
)

# GTest
http_archive(
    name = "gtest",
    urls = ["https://github.com/google/googletest/archive/refs/tags/v1.14.0.tar.gz"],
    strip_prefix = "googletest-1.14.0",
)

# Load local repository rules
load("//:repositories.bzl", "medusa_repositories")
medusa_repositories()