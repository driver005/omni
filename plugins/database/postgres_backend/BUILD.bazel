load("@rules_cc//cc:defs.bzl", "cc_library")
load("//bazel:build_defs.bzl", "congelado_cxx26_copts")
load("//third_party:copts.bzl", "congelado_linkopts")

# Storage-only Postgres backend plugin. Implements interfaces::IDatabase and
# advertises CONGELADO_CAP_STORAGE so the host wires it into Connector.
# Native cc_library is used directly (instead of congelado_module_library)
# because the plugin needs libpq linkopts, which the macro does not expose.
cc_library(
    name = "postgres_backend_plugin",
    module_interfaces = ["bin/postgres_backend_plugin.cc"],
    hdrs = ["bin/postgres_backend_plugin.cc"],
    copts = congelado_cxx26_copts() + ["-Iinclude/sdk/plugin/include"],
    linkopts = congelado_linkopts(),
    deps = [
        "//include/sdk/plugin:congelado_plugin",
        "//include/core/bridge:core_bridge",
        "//include/interfaces:interfaces",
        "//include/shared:shared",
        "//include/core/logger:core_logger",
        "//include/core/events:core_events",
        "@libpq//:libpq",
        "@system_libstdcxx//:std",
    ],
    features = ["cpp_modules"],
    visibility = ["//visibility:public"],
)
